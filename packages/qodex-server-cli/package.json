{
  "name": "@qodex/server-cli",
  "private": true,
  "bin": {
    "qodex": "./dist/server-cli.js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "scripts": {
    "build": "tsup",
    "stage": "pnpm run build && tsx src/packaging/stageCli.ts",
    "stage:remote-assets": "tsx src/packaging/stageRemoteAssetsCli.ts",
    "spike:proxy-stdio-docker": "node scripts/verify-proxy-stdio-docker.mjs",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/node-ws": "^1.3.1",
    "@napi-rs/keyring": "2.1.2",
    "@qodex/rpc": "workspace:*",
    "@qodex/services": "workspace:*",
    "@qodex/shared": "workspace:*",
    "hono": "^4.13.18",
    "ws": "^8.23.0",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
