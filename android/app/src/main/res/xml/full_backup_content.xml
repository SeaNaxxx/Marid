<?xml version="1.0" encoding="utf-8"?>
<!--
  Audit C-02: legacy (API < 31) backup policy companion to
  allowBackup="false" — excluded here as well so a future backup re-enable
  can never silently reintroduce credential transfer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
